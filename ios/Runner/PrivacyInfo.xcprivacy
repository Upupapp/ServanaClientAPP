<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Privacy manifest for the Servana customer app.

	  Required by Apple since May 2024. Its absence is grounds for an automated
	  email or a rejection, and the declarations here must MATCH the App Privacy
	  answers given in App Store Connect — Apple compares them.

	  SCOPE: this file covers the Runner target only. Each third-party SDK ships
	  its own manifest and Xcode aggregates them into the privacy report at
	  archive time; Firebase (11.4.0) and the Flutter plugins used here all do.
	  Do NOT re-declare their required-reason APIs here.

	  Every entry below was verified against the code, not assumed. If the app
	  starts collecting something new, this file and the App Store Connect
	  questionnaire must both be updated.
	-->

	<!--
	  Tracking = linking this app's data to third-party data for advertising or
	  sharing with a data broker.

	  FALSE, and deliberately so. The app never presents an App Tracking
	  Transparency prompt, so on iOS the advertising identifier is unavailable
	  and Firebase cannot read it. See the note on FirebaseAnalytics/AdIdSupport
	  in the README: the pod variant links AdSupport, but without an ATT
	  authorisation nothing is collected through it.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Account identity. Collected at sign-up, linked to the account, used
		     to operate the service. Not used for tracking. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhoneNumber</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Service address and, during an active booking, the provider's live
		     location shown on a map. lib/modules/tracking sends latitude and
		     longitude. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhysicalAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Photos a customer attaches to a job order so the provider can see
		     the work before arriving (lib/modules/job_order). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- NO NSPrivacyCollectedDataTypePaymentInfo, and that is correct.

		     All payments go through PayMongo hosted checkout, opened in a
		     WebView restricted to an explicit host allowlist
		     (lib/common/presentation/screens/payment_webview_screen.dart). The
		     customer enters card details on PayMongo's page; this app never
		     receives, stores or transmits them.

		     A dead add_credit_card_screen.dart with cardNumber/expiry/cvv
		     fields used to sit in lib/modules/payments — unreachable, its
		     router import commented out. It was deleted rather than left in
		     place, because the only way this declaration becomes wrong is
		     someone re-enabling that screen. app_store_readiness_test.dart
		     fails if card-entry UI reappears without this declaration. -->

		<!-- Customer support tickets and in-app messages with the provider. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCustomerSupport</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Firebase Analytics. The app's own AnalyticsPrivacyFilter bans email,
		     phone, name and similar keys from every event payload, so what is
		     collected is interaction and the Firebase app-instance id. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Crashlytics and Firebase Performance. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!--
	  Required-reason APIs used by the Runner target itself.

	  Deliberately EMPTY. The Runner target is a stock Flutter host: AppDelegate
	  registers plugins, sets the notification-centre delegate and hands the
	  Maps key to GMSServices. It touches no required-reason API directly.
	  Everything that does — UserDefaults, file timestamps, disk space, system
	  boot time — lives in plugins that declare it in their own manifests.

	  Do not pad this array to look thorough. A declaration Apple cannot
	  corroborate against the binary is a defect, not caution.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
