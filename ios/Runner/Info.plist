<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Servana</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Google Maps: inject GOOGLE_MAPS_API_KEY via CI secret or local
	     build environment (e.g. Flutter --dart-define or a pre-build script
	     that writes RunnerConfig/Secrets.xcconfig). Never commit the real key. -->
	<key>GMSApiKey</key>
	<string>REPLACE_WITH_GOOGLE_MAPS_API_KEY</string>
	<!-- Google Sign-In client id.
	     google_sign_in_ios resolves the client id from GIDClientID here, or
	     failing that from a GoogleService-Info.plist inside the app bundle.
	     GoogleService-Info.plist exists on disk but is NOT referenced by
	     Runner.xcodeproj, so it is never copied into the bundle and the
	     fallback does not apply — without this key, Google Sign-In fails at
	     runtime on iOS with no build-time warning.
	     Must equal CLIENT_ID in ios/Runner/GoogleService-Info.plist; asserted
	     by test/common/firebase_single_project_test.dart. -->
	<key>GIDClientID</key>
	<string>320379709991-7npea534t292ocslpmonotq3ac9s85do.apps.googleusercontent.com</string>
	<!-- Google Sign-In callback: REVERSED_CLIENT_ID from GoogleService-Info.plist -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.320379709991-7npea534t292ocslpmonotq3ac9s85do</string>
			</array>
		</dict>
		<!-- Facebook Sign-In: Replace FB_APP_ID with your Facebook App ID
		     from developers.facebook.com after creating a Facebook App -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb2048115409245680</string>
			</array>
		</dict>
	</array>
	<key>FacebookAppID</key>
	<string>2048115409245680</string>
	<key>FacebookClientToken</key>
	<string>85785ea054884504017e00d1907ea9b5</string>
	<key>FacebookDisplayName</key>
	<string>Servana</string>
	<!-- Allow Facebook SDK to query installed apps -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fbapi</string>
		<string>fb-messenger-share-api</string>
		<string>fbauth2</string>
		<string>fbshareextension</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Service app will use you photos to give more details on your job orders</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Service app needs your location to search for nearby merchants.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Service app needs your location to search for nearby merchants.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Service app will use you photos to give more details on your job orders</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
