# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Native build output. `/build/` above only covers the repo root, so Gradle's
# and Xcode's own build directories were never ignored: five files under
# ios/build/XCBuildData were committed, and the dev branch added a 663-line
# android/build Gradle problems report. Build output is not source.
/android/build/
/android/*/build/
/ios/build/
/macos/build/

# CocoaPods working state — regenerated by `pod install`, never committed.
# (Podfile and Podfile.lock ARE tracked; these are not.)
/ios/Pods/
/ios/.symlinks/
/macos/Pods/
/macos/.symlinks/

# Generated by `flutter pub get`; contains absolute machine paths, same class
# of problem as android/local.properties above.
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Flutter/ephemeral/

# Local machine config — never commit Windows/Mac absolute paths
/android/local.properties
/android/key.properties

# Firebase credentials — must never be committed; inject via CI or flutterfire configure.
# NOTE: these entries were inert until 2026-08-01. .gitignore does not untrack a
# file git already knows about, so all three stayed committed (and rotated keys
# went straight back into history). They are now untracked; the .example
# templates below are the tracked stand-ins. See README → Firebase configuration.
# Firebase CLIENT config is NOT a secret and IS committed, deliberately.
#
# These three files identify the Firebase project; they authorise nothing. Every
# one of them is extractable from any shipped APK or IPA in about a minute, which
# is why Google documents them as public. What protects the project is Firebase
# Security Rules and the backend's verifyIdToken — not the obscurity of an app id.
#
# They were untracked in 49acba9 as part of a credential sweep. That was wrong,
# and it broke the build for everyone: lib/main.dart imports firebase_options.dart,
# so CI could not analyze or build the app at all. The local checkout still had
# the file, so it looked fine on a developer machine and failed only in CI.
#
# The genuinely secret Firebase credential is the ADMIN SDK service account key,
# which lives in servana_api and is correctly untracked there.
#
# lib/firebase_options.dart
# android/app/google-services.json
# ios/Runner/GoogleService-Info.plist

# Test coverage output — regenerated by `flutter test --coverage`
coverage/
