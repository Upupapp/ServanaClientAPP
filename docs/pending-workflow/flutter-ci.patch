>   # ---------------------------------------------------------------------------
>   # iOS release to TestFlight (TAB 16).
>   #
>   # `build-ios` produced an unsigned archive and stopped there, so every
>   # TestFlight build was a manual act on somebody's laptop — unversioned,
>   # unreproducible, and impossible to attribute to a commit. Android had
>   # `release-android`; iOS had nothing.
>   #
>   # ## Signing approach: App Store Connect API key. One approach, committed to.
>   #
>   # Match-style encrypted certificate storage also works, but MIXING the two is
>   # what produces the provisioning-profile mismatches that consume days. This
>   # picks API-key signing because it needs no shared certificate repository and
>   # no extra secret rotation path: three secrets, revocable from App Store
>   # Connect, and Xcode fetches and manages the profile itself.
>   #
>   # ## Why no named GitHub environment
>   #
>   # Deliberate. A named environment can only be created by somebody with
>   # repository admin, and choosing one previously left a release job unable to
>   # go green because the secrets could not be set. Job-level `env` instead.
>   #
>   # ## The secrets-in-`if:` trap, already paid for once
>   #
>   # The `secrets` context is NOT available in a step-level `if:`, and a step's
>   # own `env:` is not available to its own `if:`. So the guard is a JOB-level
>   # env var tested in the step condition. Following the pattern rather than
>   # rediscovering it.
>   #
>   # Gated on `validate` and `build-ios` only — deliberately NOT on the Android
>   # release, exactly as `release-android` does not wait on iOS. A Play release
>   # must never be blocked by a macOS runner, and the reverse holds too.
>   # ---------------------------------------------------------------------------
>   release-ios:
>     name: Release Build (iOS → TestFlight)
>     runs-on: macos-latest
>     needs: [validate, build-ios]
> 
>     # Only main, and only when the signing material actually exists. A release
>     # job that runs on every push and fails for want of a secret trains people
>     # to ignore a red iOS build.
>     if: >-
>       github.ref == 'refs/heads/main' &&
>       github.event_name == 'push'
> 
>     permissions:
>       contents: read
> 
>     env:
>       # Job level, so the step `if:` below can read it. See the note above.
>       HAVE_ASC_KEY: ${{ secrets.ASC_KEY_ID != '' && secrets.ASC_ISSUER_ID != '' && secrets.ASC_KEY_P8 != '' }}
>       ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
>       ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
>       ASC_KEY_P8: ${{ secrets.ASC_KEY_P8 }}
>       APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
> 
>     steps:
>       - name: Checkout
>         uses: actions/checkout@v4
> 
>       - name: Signing material present?
>         run: |
>           if [ "$HAVE_ASC_KEY" != "true" ]; then
>             echo "::warning::ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8 are not all set — skipping the TestFlight upload."
>             echo "::warning::Set them in repository secrets. See docs/runbooks/IOS_RELEASE.md."
>           fi
> 
>       - name: Set up Flutter
>         uses: subosito/flutter-action@v2
>         with:
>           flutter-version: 3.47.0
>           channel: stable
>           cache: true
> 
>       - name: Pub get
>         run: flutter pub get
> 
>       # Monotonic and traceable: the build number is the run number, and the
>       # marketing version stays in pubspec as the single source. Two builds can
>       # never claim the same number, and any TestFlight build can be traced to
>       # the run and the commit that produced it.
>       - name: Compute build number
>         id: bn
>         run: |
>           echo "build_number=${{ github.run_number }}" >> "$GITHUB_OUTPUT"
>           echo "::notice::marketing version from pubspec, build number ${{ github.run_number }} (commit ${GITHUB_SHA:0:7})"
> 
>       - name: Install the App Store Connect API key
>         if: env.HAVE_ASC_KEY == 'true'
>         run: |
>           mkdir -p ~/private_keys
>           # The p8 is written outside the workspace so it cannot be picked up by
>           # a later artifact upload, and the runner is ephemeral.
>           printf '%s' "$ASC_KEY_P8" > ~/private_keys/AuthKey_${ASC_KEY_ID}.p8
>           chmod 600 ~/private_keys/AuthKey_${ASC_KEY_ID}.p8
> 
>       - name: Build signed IPA
>         if: env.HAVE_ASC_KEY == 'true'
>         timeout-minutes: 60
>         run: |
>           set -euo pipefail
>           flutter build ipa --release \
>             --build-number="${{ steps.bn.outputs.build_number }}" \
>             --export-options-plist=ios/ExportOptions.plist
> 
>       - name: Upload to TestFlight
>         if: env.HAVE_ASC_KEY == 'true'
>         timeout-minutes: 45
>         run: |
>           set -euo pipefail
>           IPA=$(find build/ios/ipa -name '*.ipa' | head -1)
>           if [ -z "$IPA" ]; then
>             echo "::error::No .ipa was produced. A green run that uploaded nothing is worse than a red one."
>             exit 1
>           fi
>           xcrun altool --upload-app -f "$IPA" -t ios \
>             --apiKey "$ASC_KEY_ID" --apiIssuer "$ASC_ISSUER_ID"
> 
>       - name: Remove the signing key
>         if: always()
>         run: rm -rf ~/private_keys
> 
>       - name: Upload IPA artifact
>         if: always()
>         uses: actions/upload-artifact@v4
>         with:
>           name: ios-ipa-${{ github.sha }}
>           path: build/ios/ipa/*.ipa
>           retention-days: 14
>           if-no-files-found: warn
